{
  "name": "wellbourne-report-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5183 --strictPort",
    "data": "python3 scripts/prepare_data.py",
    "test": "node --test tests/access.test.mjs tests/report.test.mjs tests/deployment.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run test && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5184 --strictPort",
    "test:audit": "node --test tests/evidence.test.mjs",
    "build:vercel": "npm run build && node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
